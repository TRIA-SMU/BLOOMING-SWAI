# 이 파일을 복사해서 같은 폴더에 application-secret.properties 로 저장하고 키를 넣는다.
# application-secret.properties 는 .gitignore에 있어서 GitHub에 안 올라간다.
gemini.api-key=여기에_키_붙여넣기

# 구글 로그인 (Google Cloud Console > OAuth 클라이언트 ID)
spring.security.oauth2.client.registration.google.client-id=여기에_클라이언트_ID
spring.security.oauth2.client.registration.google.client-secret=여기에_클라이언트_보안_비밀번호
spring.security.oauth2.client.registration.google.scope=email,profile

# 로그인 토큰 서명용 비밀키 (아무 글자나 32자 이상)
app.jwt.secret=여기에_32자_이상_아무_문자열
